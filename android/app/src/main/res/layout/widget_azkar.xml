<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mes Azkar"
        android:textColor="#B8CFC9"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="—"
        android:textColor="#D9A94A"
        android:textStyle="bold"
        android:textSize="15sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fajr" android:textColor="#8FADA5" android:textSize="9sp" />
            <TextView android:id="@+id/tv_time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F5F1E6" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_iqama_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6E8983" android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dohr" android:textColor="#8FADA5" android:textSize="9sp" />
            <TextView android:id="@+id/tv_time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F5F1E6" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_iqama_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6E8983" android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asr" android:textColor="#8FADA5" android:textSize="9sp" />
            <TextView android:id="@+id/tv_time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F5F1E6" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_iqama_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6E8983" android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maghrib" android:textColor="#8FADA5" android:textSize="9sp" />
            <TextView android:id="@+id/tv_time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F5F1E6" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_iqama_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6E8983" android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isha" android:textColor="#8FADA5" android:textSize="9sp" />
            <TextView android:id="@+id/tv_time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F5F1E6" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_iqama_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#6E8983" android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_sunrise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="🌅 Chourouk --:--"
        android:textColor="#8FADA5"
        android:textSize="9.5sp" />

</LinearLayout>
